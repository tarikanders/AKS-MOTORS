{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.aksmotors.com" }],
      "destination": "https://aksmotors.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "www.aksmotors.com" }],
      "destination": "https://aksmotors.com/:path+",
      "permanent": true
    }
  ]
}
