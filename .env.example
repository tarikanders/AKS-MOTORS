# --- Formulaire de contact (Resend) ---
# Clé API Resend. À créer sur https://resend.com (gratuit jusqu'à 3000 emails/mois).
# À définir dans Vercel : Project Settings > Environment Variables.
# Doit appartenir au compte Resend où aksmotors.com est vérifié.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Adresse qui reçoit les demandes du formulaire (boîte Zoho).
CONTACT_TO_EMAIL="contact@aksmotors.com"

# Expéditeur. Le domaine aksmotors.com est vérifié dans Resend (région eu-west-1)
# via DKIM `resend._domainkey` + SPF/MX sur le sous-domaine `send`.
CONTACT_FROM_EMAIL="AKS Motors <contact@aksmotors.com>"
